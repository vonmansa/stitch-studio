# docker-compose.yml automatically reads a file named ".env" in the
# same directory as itself and substitutes ${POSTGRES_DB} etc. with
# these values. Copy this file to .env and adjust as needed:
#
#   cp .env.example .env
#
# .env is already covered by the root .gitignore's ".env" rule — never
# commit real credentials, even placeholder-looking local ones.

POSTGRES_DB=stitch_studio
POSTGRES_USER=stitchuser
POSTGRES_PASSWORD=changeme
